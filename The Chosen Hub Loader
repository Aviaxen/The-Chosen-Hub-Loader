local Settings = {
    SelectedLibrary = nil, 
    AutoLoad = false
}

-- Safe File Checking System
local function SafeLoadSettings()
    if pcall(function() return readfile and readfile("XVCHubSettings.json") end) then
        local fileData = readfile("XVCHubSettings.json")
        if fileData and fileData ~= "" then
            local success, decoded = pcall(function()
                return game:GetService("HttpService"):JSONDecode(fileData)
            end)
            if success and decoded then
                Settings = decoded
            end
        end
    end
end
SafeLoadSettings()

-- Direct AutoLoad Handler (Bypasses the broken main files)
if Settings.SelectedLibrary and Settings.AutoLoad then
    local downloadSuccess, scriptData
    if Settings.SelectedLibrary == "Windui" then
        downloadSuccess, scriptData = pcall(function()
            return game:HttpGet("https://githubusercontent.com")
        end)
    elseif Settings.SelectedLibrary == "Rayfield" then
        downloadSuccess, scriptData = pcall(function()
            return game:HttpGet("https://githubusercontent.com")
        end)
    end
    
    if downloadSuccess and scriptData then
        loadstring(scriptData)()
        return
    end
end

-- Simplified UI Parenting Layer to force presentation
local XVCHubLoader = Instance.new("ScreenGui")
XVCHubLoader.Name = "XVCHubLoader_" .. tostring(math.random(1000, 9999))
XVCHubLoader.ResetOnSpawn = false
XVCHubLoader.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local gethui = gethui or get_hidden_gui
if gethui then
    XVCHubLoader.Parent = gethui()
elseif game:GetService("CoreGui"):FindFirstChildWhichIsA("ScreenGui") then
    XVCHubLoader.Parent = game:GetService("CoreGui")
else
    XVCHubLoader.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

-- MAIN INTERFACE FRAME
local Frame = Instance.new("Frame")
Frame.Parent = XVCHubLoader
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Frame.BackgroundTransparency = 0.05
Frame.BorderSizePixel = 0
Frame.AnchorPoint = Vector2.new(0.5, 0.5)
Frame.Position = UDim2.new(0.5, 0, 0.5, 0) 
Frame.Size = UDim2.new(0, 360, 0, 180) 
Frame.Visible = true

local UICorner_Main = Instance.new("UICorner")
