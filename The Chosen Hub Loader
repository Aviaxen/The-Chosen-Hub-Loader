-- The Chosen Hub Loader
-- Rayfield / WindUI selector

local Settings = {
    SelectedLibrary = nil, -- "WindUI" or "Rayfield"
    AutoLoad = false
}

local SETTINGS_FILE = "TheChosenHubSettings.json"

-- Load saved settings
local success, savedSettings = pcall(function()
    return game:GetService("HttpService"):JSONDecode(
        readfile(SETTINGS_FILE)
    )
end)

if success and savedSettings then
    Settings = savedSettings
end

-- Load selected library automatically
if Settings.SelectedLibrary and Settings.AutoLoad then
    if Settings.SelectedLibrary == "WindUI" then
        loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/Aviaxen/The-Chosen-Hub-Windui/refs/heads/main/The%20Chosen%20Hub"
        ))()
    elseif Settings.SelectedLibrary == "Rayfield" then
        loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/Aviaxen/The-Chosen-Hub/refs/heads/main/The%20Chosen%20Hub"
        ))()
    end

    return
end

-- Save settings
local function SaveSettings()
    pcall(function()
        writefile(
            SETTINGS_FILE,
            game:GetService("HttpService"):JSONEncode(Settings)
        )
    end)
end

