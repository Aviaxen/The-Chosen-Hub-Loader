-- Library button creator
local function CreateLibraryButton(name, position, description, callback)
    local Button = Instance.new("TextButton")

    Button.Name = name .. "Button"
    Button.Parent = Frame
    Button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Button.BackgroundTransparency = 0.9
    Button.BorderColor3 = Color3.fromRGB(255, 255, 255)
    Button.Position = position
    Button.Size = UDim2.new(0.42, 0, 0.226, 0)

    -- Bold
    Button.Font = Enum.Font.SourceSansBold

    Button.Text = name
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.TextScaled = true
    Button.TextWrapped = true

    local Corner = Instance.new("UICorner")
    Corner.Parent = Button

    -- Description
    local Description = Instance.new("TextLabel")
    Description.Parent = Button
    Description.BackgroundTransparency = 1
    Description.Position = UDim2.new(0, 0, 1.43, 0)
    Description.Size = UDim2.new(1, 0, 1, 0)
    Description.Font = Enum.Font.SourceSans
    Description.Text = description
    Description.TextColor3 = Color3.fromRGB(186, 186, 186)
    Description.TextScaled = true
    Description.TextWrapped = true

    Button.MouseButton1Click:Connect(callback)

    return Button
end

local buttonsEnabled = true

-- Rayfield
CreateLibraryButton(
    "Rayfield",
    UDim2.new(0.028, 0, 0.383, 0),
    "Rayfield Library - Recommended for PC",
    function()
        if not buttonsEnabled then
            return
        end

        buttonsEnabled = false

        Settings.SelectedLibrary = "Rayfield"
        SaveSettings()

        -- The Chosen Hub Rayfield
        loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/Aviaxen/The-Chosen-Hub/refs/heads/main/The%20Chosen%20Hub"
        ))()

        TheChosenHubLoader:Destroy()
    end
)

